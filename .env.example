# Copy to .env and fill in. docker-compose reads this file automatically.

# Telegram bot credentials. Create a bot with @BotFather, add it to your
# channel as an administrator, then look up the chat id (see the README).
TELEGRAM_TOKEN=123456:your-bot-token-here
TELEGRAM_CHAT_ID=-1001234567890

# Optional overrides (defaults shown). These beat the config file, which is
# what you want in a container.
# MIRRORWATCH_INTERVAL=21600
# MIRRORWATCH_LOG_LEVEL=INFO
# MIRRORWATCH_BOOTSTRAP_NOTIFY=summary
